import heapq, struct, os
from collections import Counter

OTHERS = -1  # special "symbol" that stands for the Others group


def build_codes(weights):
    """Standard Huffman on {symbol: count}. Returns {symbol: '0101'}."""
    heap = [(w, i, s) for i, (s, w) in enumerate(sorted(weights.items()))]
    heapq.heapify(heap)
    if len(heap) == 1:                       # only one symbol: give it code '0'
        return {heap[0][2]: '0'}
    next_id = len(heap)                      # tie-breaker, keeps the result deterministic
    while len(heap) > 1:
        a, b = heapq.heappop(heap), heapq.heappop(heap)   # two smallest
        heapq.heappush(heap, (a[0] + b[0], next_id, (a[2], b[2])))
        next_id += 1
    codes = {}
    def walk(node, code):                    # left = 0, right = 1
        if isinstance(node, tuple):
            walk(node[0], code + '0'); walk(node[1], code + '1')
        else:
            codes[node] = code
    walk(heap[0][2], '')
    return codes


def make_tables(n, main, others):
    """Build Huffman codes + fixed-length original codes for the Others group."""
    weights = dict(main)
    if others:
        weights[OTHERS] = n - sum(main.values())      # Others = sum of all small symbols
    codes = build_codes(weights)
    k = (len(others) - 1).bit_length() if others else 0   # bits for original code
    other_codes = {s: (format(i, 'b').zfill(k) if k else '') for i, s in enumerate(others)}
    return codes, other_codes, k


def compress(path, limit, out_name):
    data = open(path, 'rb').read()
    n = len(data)
    counts = Counter(data)
    main = {s: c for s, c in counts.items() if c / n > limit}   # kept symbols
    others = sorted(s for s in counts if s not in main)         # grouped symbols (<= limit)
    codes, other_codes, k = make_tables(n, main, others)

    bits = ''
    for b in data:
        bits += codes[b] if b in main else codes[OTHERS] + other_codes[b]

    # Header: n, number of main symbols, (symbol,count)..., number of others, others...
    header = struct.pack('>IH', n, len(main))
    header += b''.join(struct.pack('>BI', s, c) for s, c in main.items())
    header += struct.pack('>H', len(others)) + bytes(others)
    stream = ''.join(format(b, '08b') for b in header) + bits   # header bits + data bits
    open(out_name, 'w').write(stream)                           # readable 0/1 text file

    orig, comp = n, (len(stream) + 7) // 8      # size if the bits were packed 8 per byte
    print(f'\nStream of bits saved to {out_name}: {len(stream)} bits (header {len(header) * 8} + data {len(bits)})')
    print(f'Original size  : {orig} bytes')
    print(f'Compressed size: {comp} bytes')
    print(f'Compression ratio: {orig / comp:.2f} : 1  (saved {100 * (1 - comp / orig):.1f}%)')


def decompress(in_name, out_name):
    stream = open(in_name).read().strip()                         # text of 0s and 1s
    blob = bytes(int(stream[i:i + 8], 2) for i in range(0, len(stream) - 7, 8))
    n, m = struct.unpack_from('>IH', blob, 0)
    pos = 6
    main = {}
    for _ in range(m):
        s, c = struct.unpack_from('>BI', blob, pos); main[s] = c; pos += 5
    o = struct.unpack_from('>H', blob, pos)[0]; pos += 2
    others = list(blob[pos:pos + o]); pos += o

    codes, _, k = make_tables(n, main, others)       # rebuild the same tables
    decode = {code: s for s, code in codes.items()}
    bits = stream[pos * 8:]                          # data bits come after the header

    out, cur, i = bytearray(), '', 0
    while len(out) < n:                              # read bit by bit until a code matches
        cur += bits[i]; i += 1
        if cur in decode:
            s = decode[cur]
            if s == OTHERS:                          # read the original code that follows
                s = others[int(bits[i:i + k], 2) if k else 0]; i += k
            out.append(s); cur = ''
    open(out_name, 'wb').write(out)
    print(f'Decoded {n} symbols. Saved to {out_name}')
    return bytes(out)


while True:
    print('\n1) Compress a file\n2) Decompress a file\n3) Exit')
    choice = input('Choose: ').strip()
    if choice == '1':
        path = input('Input file: ').strip()
        limit = float(input('Minimum probability limit (e.g. 0.05): '))
        out_name = input('Output file name (e.g. compressed.txt): ').strip() or 'compressed.txt'
        if os.path.getsize(path) == 0:
            print('File is empty.')
        else:
            compress(path, limit, out_name)
    elif choice == '2':
        in_name = input('Compressed file name (e.g. compressed.txt): ').strip() or 'compressed.txt'
        out_name = input('Output file name (e.g. decompressed.txt): ').strip() or 'decompressed.txt'
        result = decompress(in_name, out_name)
        original = input('Original file to compare (Enter to skip): ').strip()
        if original:
            print('Match! Decompressed file equals the original.' if open(original, 'rb').read() == result else 'MISMATCH!')
    elif choice == '3':
        break
